{
  "name": "mabu-toolbox",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "41 个纯前端在线小工具，文件不上传，全部在浏览器本地处理",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seo": "node scripts/prerender.mjs",
    "icons": "node scripts/make-icons.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "node tests/e2e.cjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "jszip": "^3.10.1",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
